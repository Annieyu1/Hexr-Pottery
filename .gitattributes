# Auto detect text files and perform LF normalization
* text=auto

# Study room art: large binaries go through Git LFS (scoped to these paths so existing tutorial assets stay as they are)
Assets/Art/**/*.fbx filter=lfs diff=lfs merge=lfs -text
Assets/Art/**/*.png filter=lfs diff=lfs merge=lfs -text
Assets/Scenes/*/*.exr filter=lfs diff=lfs merge=lfs -text
art/blender/*.blend filter=lfs diff=lfs merge=lfs -text
art/textures/*.png filter=lfs diff=lfs merge=lfs -text
art/textures/t11/*.png filter=lfs diff=lfs merge=lfs -text
art/textures/t2/*.png filter=lfs diff=lfs merge=lfs -text
